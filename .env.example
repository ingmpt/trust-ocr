# ─────────────────────────────────────────────────────────────────────────────
# Producción — Server 1 (VPS con Traefik ya existente en el nodo).
# Copiar a `.env` (mismo directorio que docker-compose.prod.yml). Único
# archivo de entorno de producción — NUNCA se commitea (ver .gitignore).
# Permisos recomendados: chmod 600, owner=deploy.
# Su propósito es autenticar contra Infisical; todos los secretos de negocio
# (SECRET_KEY, GEMINI_API_KEY, R2_*, ZOHO_*, AUDIT_SIGNING_API_KEY, etc.) viven
# en Infisical y se leen en runtime — NO los agregues aquí.
# ─────────────────────────────────────────────────────────────────────────────

SECRETS_PROVIDER=infisical
INFISICAL_API_URL=https://CHANGE_ME_INFISICAL_DOMAIN
INFISICAL_CLIENT_ID=CHANGE_ME
INFISICAL_CLIENT_SECRET=CHANGE_ME
INFISICAL_PROJECT_ID=CHANGE_ME
INFISICAL_ENVIRONMENT=prod

# ── Credenciales mínimas para que Postgres/Redis arranquen ───────────────────
# (las necesitan en su propio proceso de arranque, no vía SDK; deben coincidir
# EXACTAMENTE con los valores que la app luego recibe desde Infisical)
DATABASE_USER=trustocr
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=trustocr
REDIS_PASSWORD=CHANGE_ME

# ── Frontend (se hornea en el bundle de Vite en build-time) ──────────────────
VITE_API_BASE_URL=https://ocr.trustedtechnologyperu.com/api/v1
