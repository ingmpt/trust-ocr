# =============================================================================
# Trust OCR+ — Variables de entorno (EJEMPLO). Copiar a .env y completar valores
# reales. NUNCA commitear el archivo .env con valores reales.
#
# FLUJO DE SECRETOS (ver backend/app/bootstrap_secrets.py):
#   Opción A — Infisical (recomendada, todos los entornos incluido local):
#     Dejar sólo la sección "Infisical (bootstrap)" de abajo con datos reales
#     y BORRAR/dejar vacías todas las variables de secretos de negocio
#     (SECRET_KEY, GEMINI_API_KEY, R2_*, ZOHO_*, AUDIT_SIGNING_API_KEY,
#     CULQI_*, NUBEFACT_*) — la app las descarga de Infisical en el arranque.
#     Esos valores deben existir como Secrets en el proyecto de Infisical,
#     bajo el entorno indicado en INFISICAL_ENVIRONMENT (p. ej. "dev").
#   Opción B — Sin Infisical (fallback legado, sólo para desarrollo puntual
#     sin acceso al proyecto de Infisical): dejar SECRETS_PROVIDER vacío y
#     completar los valores reales directamente aquí.
# =============================================================================

# --- Infisical (bootstrap) ---
# Credenciales para AUTENTICAR contra Infisical (Machine Identity, Universal
# Auth). Estas SÍ viven en este archivo (nunca en Infisical, son las llaves
# para llegar a él). Dejar SECRETS_PROVIDER vacío para usar el fallback local.
SECRETS_PROVIDER=
INFISICAL_API_URL=https://app.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev

# --- Aplicación ---
APP_ENV=local
APP_DEBUG=true
# Secreto de negocio: sólo completar aquí si SECRETS_PROVIDER está vacío (Opción B).
SECRET_KEY=change-me-to-a-long-random-string

# --- Base de datos (PostgreSQL) --- (no se gestiona vía Infisical, es local a este entorno)
DATABASE_URL=postgresql+psycopg2://trustocr:trustocr@localhost:5433/trustocr

# --- Redis (cache modo Express + broker de Celery) --- (no se gestiona vía Infisical)
REDIS_URL=redis://localhost:6379/0
EXPRESS_RESULT_TTL_SECONDS=3600

# --- Autenticación --- (no son secretos, parámetros de configuración)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY_PREFIX=tocr_

# --- Motor OCR (PaddleOCR) ---
# "paddleocr" (real) o "mock" (desarrollo local sin dependencias pesadas de ML)
OCR_ENGINE=mock

# --- Servicio de corrección/estructuración LLM (Gemini) ---
# Secreto de negocio: sólo completar aquí si SECRETS_PROVIDER está vacío (Opción B).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Almacenamiento de objetos (Cloudflare R2, S3-compatible) ---
# Secretos de negocio: sólo completar aquí si SECRETS_PROVIDER está vacío (Opción B).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=trust-ocr-documents
R2_ENDPOINT_URL=
STORAGE_RETENTION_DAYS=5

# --- Correo transaccional (Zoho) ---
# Secretos de negocio: sólo completar aquí si SECRETS_PROVIDER está vacío (Opción B).
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
ZOHO_FROM_EMAIL=no-reply@trustocr.com

# --- Registro de auditoría inmutable (proveedor externo pendiente de selección) ---
# Interfaz abstracta; "none" deshabilita la firma externa y sólo usa el log
# append-only en PostgreSQL (comportamiento por defecto hasta seleccionar proveedor).
AUDIT_SIGNING_PROVIDER=none
AUDIT_SIGNING_API_KEY=

# --- CAPTCHA (Cloudflare Turnstile) ---
# Secreto de negocio: sólo completar aquí si SECRETS_PROVIDER está vacío (Opción B).
# Vacío deshabilita la verificación de CAPTCHA (comportamiento por defecto en local).
TURNSTILE_SECRET_KEY=

# --- Pagos (Culqi) — preparado, no integrado en MVP ---
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# --- Facturación electrónica (Nubefact) — preparado, no integrado en MVP ---
NUBEFACT_TOKEN=
NUBEFACT_RUC_EMISOR=

# --- Frontend (CORS) ---
FRONTEND_ORIGIN=http://localhost:5173

