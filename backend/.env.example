# =============================================================================
# Trust OCR+ — Variables de entorno (EJEMPLO). Copiar a .env y completar valores
# reales. NUNCA commitear el archivo .env con valores reales.
# =============================================================================

# --- Aplicación ---
APP_ENV=local
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://trustocr:trustocr@localhost:5433/trustocr

# --- Redis (cache modo Express + broker de Celery) ---
REDIS_URL=redis://localhost:6379/0
EXPRESS_RESULT_TTL_SECONDS=3600

# --- Autenticación ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY_PREFIX=tocr_

# --- Motor OCR (PaddleOCR) ---
# "paddleocr" (real) o "mock" (desarrollo local sin dependencias pesadas de ML)
OCR_ENGINE=mock

# --- Servicio de corrección/estructuración LLM (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Almacenamiento de objetos (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=trust-ocr-documents
R2_ENDPOINT_URL=
STORAGE_RETENTION_DAYS=5

# --- Correo transaccional (Zoho) ---
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
ZOHO_FROM_EMAIL=no-reply@trustocr.com

# --- Registro de auditoría inmutable (proveedor externo pendiente de selección) ---
# Interfaz abstracta; "none" deshabilita la firma externa y sólo usa el log
# append-only en PostgreSQL (comportamiento por defecto hasta seleccionar proveedor).
AUDIT_SIGNING_PROVIDER=none
AUDIT_SIGNING_API_KEY=

# --- Pagos (Culqi) — preparado, no integrado en MVP ---
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# --- Facturación electrónica (Nubefact) — preparado, no integrado en MVP ---
NUBEFACT_TOKEN=
NUBEFACT_RUC_EMISOR=

# --- Frontend (CORS) ---
FRONTEND_ORIGIN=http://localhost:5173
