# Traefik producción — variables de este stack (NO son secretos de la app,
# viven en este nodo únicamente; el htpasswd real va en ./secrets/traefik_htpasswd,
# nunca en este archivo).

# Contacto para Let's Encrypt (recibe avisos de expiración/rate-limit)
ACME_EMAIL=devops@trustedtechnologyperu.com

# Dominio del dashboard de Traefik de ESTE nodo (Server 1 — SaaS Layer).
TRAEFIK_DASHBOARD_HOST=traefik.trustedtechnologyperu.com

# IPs permitidas para el dashboard (tu IP de administración). Formato CIDR,
# separadas por coma. Ejemplo: "203.0.113.10/32,198.51.100.0/24"
ADMIN_IP_ALLOWLIST=CHANGE_ME/32
